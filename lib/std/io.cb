;; I/O Formatting Library

fn std_fset
    ;; takes in array [x y z ...] on stack
    if defined STDFORMAT do
        release STDFORMAT
    end
    $STDFORMAT
end

fn std_fprintln
    ;; takes in "text" on stack
    if defined STDFORMAT do
        pass
    else
        ["NO FORMAT DEFINED. "] $STDFORMAT
    end
    $STDTEXT
    "" $STDFS
    
    @STDFORMAT len for i
        @STDFS @STDFORMAT @i get && $STDFS
    end
    
    @STDFS @STDTEXT && .
    release STDFS
    release STDTEXT
end

fn std_fprint
    ;; takes in "text" on stack
    if defined STDFORMAT do
        pass
    else
        ["NO FORMAT DEFINED! "] $STDFORMAT
    end
    $STDTEXT
    "" $STDFS
    
    @STDFORMAT len for i
        @STDFS @STDFORMAT @i get && $STDFS
    end
    
    @STDFS @STDTEXT && ,
    release STDFS
    release STDTEXT
end

fn std_fask
    ;; takes in "prompt" on stack
    if defined STDFORMAT do
        pass
    else
        ["NO FORMAT DEFINED! "] $STDFORMAT
    end
    $STDTEXT
    "" $STDFS
    
    @STDFORMAT len for i
        @STDFS @STDFORMAT @i get && $STDFS
    end
    
    @STDFS @STDTEXT && ask
    release STDFS
    release STDTEXT
end

fn std_clearquit
    clearscr quit
end