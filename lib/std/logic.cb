;; LOGIC

fn and
    ;; takes in a b on stack -> pushes 1 or 0
    if depth 2 >= do
        $STDA
        $STDB
        if @STDA 0 != do
            if @STDB 0 != do
                1
            else
                0
            end
        else
            0
        end
        release STDA
        release STDB
    else
        "Stack Error" "Stack Underflow" error
    end
end

fn not
    ;; takes in a on stack -> pushes 1 if 0, else 0
    if depth 1 >= do
        $STDA
        if @STDA 0 = do
            1
        else
            0
        end
        release STDA
    else
        "Stack Error" "Stack Underflow" error
    end
end

fn or
    ;; takes in a b on stack -> pushes 1 or 0
    if depth 2 >= do
        $STDA
        $STDB
        if @STDA 0 != do
            1
        else
            if @STDB 0 != do
                1
            else
                0
            end
        end
        release STDA
        release STDB
    else
        "Stack Error" "Stack Underflow" error
    end
end

fn <=>
    $x $y
    @y @x >
    @y @x < 
    -
end  