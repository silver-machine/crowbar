;; FILE I/O LIB

fn std_openf
    ;; takes in "name" (str) on stack
    $STDFILE
end

fn std_newf
    ;; takes in "name" (str) on stack
    $n
    create @n
    @n std_openf
    release n
end

fn std_writef
    ;; takes in data (str) on stack
    $d
    @d write @STDFILE
    release d
end

fn std_appendf
    ;; takes in data (str) on stack
    $d
    @d append @STDFILE
    release d
end

fn std_getlinef
    ;; takes in line index (int) on stack
    getline @STDFILE
end

fn std_getlinesf
    getlines @STDFILE
end

fn std_closef
    if defined STDFILE do
        release STDFILE
    end
end