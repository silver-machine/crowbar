;; Crowbar math lib

;; Square a number
fn square
    dup *
end

;; Absolute value
fn abs
    $x
    if @x 0 < do
        0 @x - 
    else
        @x
    end
    release x
end

;; Square root (Newton's Method)
fn sqrt
    $x
    if @x 0 < do
        "ValueError" "Cannot take sqrt of negative number" error
    end
    if @x 0 = do
        0
    else
        1.0 $guess
        50 $n
        while @n 0 > do
            @guess @x @guess / + 2 / $guess
            @n 1 - $n
        end
        release n
        @guess
    end
    release x
end

;; Power function: x y pow -> x^y
fn pow
    $exponent
    $base
    1 $result
    0 $counter
    while @counter @exponent < do
        @result @base * $result
        @counter 1 + $counter
    end
    release counter
    release exponent
    release base
    @result
end

;; Natural logarithm: x ln -> ln(x)
fn ln
    $x
    if @x 0 <= do
        "ValueError" "ln expects a positive number" error
    end
    
    ;; Using series expansion: 2 * sum( ((x-1)/(x+1))^(2k+1) / (2k+1) )
    @x 1 - @x 1 + / $y
    @y dup * $y2
    @y $term
    @y $sum
    1 $k
    
    while @k 50 < do
        @term @y2 * $term
        @sum @term @k 2 * 1 + / + $sum
        @k 1 + $k
    end
    
    release x
    release y
    release y2
    release term
    release k
    
    @sum 2 *
end